{
  "name": "@replyze/vue",
  "version": "0.1.1",
  "description": "Vue live chat widget for Vue 3 and Nuxt: the Replyze AI support chat as a component, plugin and composables, with identity verification",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:widget": "vitest run --config vitest.widget.config.ts",
    "test:types": "tsc -p test/types",
    "prepare": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "nuxt3",
    "nuxt4",
    "live-chat",
    "chat-widget",
    "vue-chat-widget",
    "live-chat-widget",
    "ai-chatbot",
    "chatbot",
    "customer-support",
    "helpdesk",
    "replyze"
  ],
  "homepage": "https://github.com/Replyze/vue-live-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Replyze/vue-live-chat.git"
  },
  "bugs": {
    "url": "https://github.com/Replyze/vue-live-chat/issues"
  },
  "license": "MIT",
  "author": "Replyze (https://replyze.chat)",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/server-renderer": "3.5.45",
    "@vue/test-utils": "2.5.1",
    "jsdom": "27.4.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
